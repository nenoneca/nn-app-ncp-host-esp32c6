mainmenu "ESP32-C6 NCP Host"

# Pull in the nn_proto wire-format library + PSA Ed25519/SHA256 selectors.
source "$(NN_MODULES_DIR)/libs/nn_proto/Kconfig"

# fw_common — portable HDLC / Spinel / future shared logic.  Same module
# is consumed by the Linux gateway daemon (host/gw_linux/) via its own
# native CMake build.
source "$(NN_MODULES_DIR)/libs/fw_common/Kconfig"

# M6: PSA selectors for ECIES decrypt of BLE provisioning writes.
# Uses X25519 (Montgomery curve) for encryption.  P-256 (SECP_R1_256)
# stays for nn_proto signatures (deterministic ECDSA — see
# nn_proto/Kconfig).  PSA_WANT_* are invisible at prj.conf level
# (MBEDTLS_PROMPTLESS=y), so they must be selected from Kconfig.
config GW_BLE_CRYPTO_DEPS
	bool
	default y
	select PSA_WANT_ALG_ECDH
	select PSA_WANT_ALG_HKDF
	select PSA_WANT_ALG_GCM
	select PSA_WANT_ALG_SHA_256
	# X25519 (encryption)
	select PSA_WANT_ECC_MONTGOMERY_255
	# P-256 (signatures)
	select PSA_WANT_ECC_SECP_R1_256
	select PSA_WANT_KEY_TYPE_AES
	select PSA_WANT_KEY_TYPE_DERIVE
	select PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_DERIVE
	select PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_IMPORT
	select PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY

source "Kconfig.zephyr"

config NCP_NETIF_LOG_RX_OFFMESH
	bool "Print every off-mesh STREAM_NET packet entering the host"
	default n
	help
	  Diagnostic.  Logs proto/src-tail/dst-tail/UDP-ports for each
	  off-mesh IPv6 packet arriving from the NCP via Spinel
	  STREAM_NET.  Filters out MLE (port 19788) and anycast (61631)
	  intra-mesh chatter.

config NCP_LINK_LOG_UDP_FORWARD
	bool "Print SPINEL_PROP_THREAD_UDP_FORWARD_STREAM events"
	default n
	help
	  Diagnostic.  Logs both directions of UDP_FORWARD traffic
	  (commissioner path).

config BORDER_AGENT_LOG_RX
	bool "Print every UDP packet arriving on the BA listener (49191)"
	default n
	help
	  Diagnostic.  Used during external commissioner DTLS handshake
	  troubleshooting.

