	default 30

endmenu

# ── Bundle pairing ────────────────────────────────────────────────────────

config NN_BUNDLED_NCP_VERSION
	string "Expected NCP firmware version (bundle pairing)"
	default "0.0.0"
	help
	  When non-default, the host's deferred-confirm worker queries
	  the running NCP's CONFIG_NN_NCP_APP_VERSION via Spinel vendor
	  property 0x3C03 and pushes the bundled NCP image (type
	  "ncp_c6", version = this string) if they don't match — BEFORE
	  calling boot_write_img_confirmed on itself.  This makes the
	  host+NCP bundle atomic: if the NCP push fails, the host stays
	  unconfirmed and the next reboot reverts the host too.

	  Default "0.0.0" disables bundle pairing (the host self-confirms
	  on uptime+TCP gates alone, and never auto-pushes to the NCP).

config NN_BUNDLED_NCP_TYPE
	string "Hub firmware target name for the paired NCP image"
	default "ncp_c6"
	help
	  Used as the <device_type> argument to gwota_ncp / the auto
	  reconciliation loop.  Must match what was uploaded via
	  `nn-hub firmware upload <device_type> <version> <file>`.

config NN_BUNDLE_RECONCILE_MAX_ATTEMPTS
	int "Max NCP push attempts during bundle reconciliation"
	default 3
	help
	  After this many consecutive failed pushes, the host stops
	  retrying and stays unconfirmed.  The next reboot will revert
	  the host to slot0, which keeps the bundle consistent with the
	  old NCP.
